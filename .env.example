# EcomCare Agent: public template. Never commit your .env.
# scripts/init_local_env.py creates random LOCAL database/MinIO credentials.
# Fill provider keys privately; no requests are made by configuration setup.
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-v4-flash
CHAT_API_KEY=
CHAT_THINKING=adaptive
CHAT_REASONING_SPLIT=true
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=

# Generated locally; placeholders here are deliberately NOT valid secrets.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MYSQL_PORT=13307
MILVUS_PORT=29530
MILVUS_HEALTH_PORT=19091
DATABASE_URL=
TEST_DATABASE_URL=
MILVUS_URI=http://127.0.0.1:29530

AUTH_DB_PATH=data/demo_auth.sqlite
CHECKPOINTER_DB_PATH=data/checkpoints.sqlite
AUTH_TOKEN_TTL_SECONDS=3600
TURN_TIMEOUT_SECONDS=120
MAX_AGENT_STEPS=6
MAX_TASK_TOOL_CALLS=12
MAX_IDENTICAL_TOOL_CALLS=2
TASK_CONTEXT_TOKENS=800
TOOL_DEFAULT_TIMEOUT=5
MCP_TOOL_TIMEOUT=10
TOOL_MAX_RETRIES=2
TOKEN_BUDGET=2000
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTERSALES_URL=http://127.0.0.1:8102/mcp
RETRIEVAL_COLLECTION=knowledge
POLICY_CATALOG_PATH=
MODEL_PRICES={}
MODEL_PRICE_CURRENCY=CNY
COMPOUND_AGENT_ENABLED=false
COMPOUND_JOINT_TRIAGE_ENABLED=false
EVIDENCE_SELECTION_ENABLED=false
SKIP_COREF_WITHOUT_HISTORY=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# For task-v1 fixtures, set the process environment explicitly before launch:
